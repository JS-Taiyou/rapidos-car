# Variables de entorno — copia este archivo a `.env` (gitignored) y ajusta.

# Conexión a Postgres. En desarrollo puede ser un Postgres local; en
# producción es la connection string DIRECTA de Supabase (puerto 5432 —
# Settings → Database → Connection string → "Direct connection"). El pooler
# (puerto 6543) SOLO se usa si se despliega serverless (ARCHITECTURE §2.15);
# migraciones y seed siempre contra la conexión directa.
DATABASE_URL=postgres://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Número WhatsApp del negocio en formato internacional sin '+' (wa.me).
# El de staff (alertas) vive en la tabla settings; este es el público.
PUBLIC_WHATSAPP_NUMBER=5219990000000

# Origen del sitio para URLs absolutas (canonical, hreflang, OG).
PUBLIC_SITE_URL=http://localhost:4321
