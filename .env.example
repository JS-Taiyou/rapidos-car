# Variables de entorno — copia este archivo a `.env` (gitignored) y ajusta.

# Conexión a Postgres. En desarrollo, un Postgres local (sin SSL, tal cual);
# en producción, la connection string DIRECTA de Supabase (puerto 5432 —
# Settings → Database → Connection string → "Direct connection"). El SSL se
# exige automáticamente para hosts de Supabase (o sslmode=require en la URL).
# Migraciones, seed y runtime usan la misma URL mientras sea UN proceso;
# el pooler (puerto 6543, añade &pgbouncer=true a la URL) sólo si escalas
# réplicas del contenedor.
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# (alternativa local) DATABASE_URL=postgresql://usuario:pass@localhost:5432/rapidcar
#
# MODO EMBEBIDO (tenant pequeño, cero infra): Postgres REAL dentro del
# proceso, persistido en un archivo. Misma migraciones, misma constraint
# anti-doble-reserva. Sólo para UN contenedor/proceso (no réplicas).
# DATABASE_URL=pglite://./data/rapidoz

# Número WhatsApp del negocio en formato internacional sin '+' (wa.me).
# El de staff (alertas) vive en la tabla settings; este es el público.
PUBLIC_WHATSAPP_NUMBER=5219990000000

# Origen del sitio para URLs absolutas (canonical, hreflang, OG).
PUBLIC_SITE_URL=http://localhost:4321

# --- OAuth con Google para el STAFF (opcional) ---------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID
# (Web application). Authorized redirect URI:
#   http://localhost:4321/api/auth/google/callback  (dev)
#   https://TU-DOMINIO/api/auth/google/callback      (prod)
# Sólo entra quien ya tenga cuenta activa en /admin/usuarios (allowlist);
# sin estas variables el botón simplemente no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
