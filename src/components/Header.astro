---
// Chrome superior: logo (icono+color o imagen del tenant), navegación y
// CTA Reservar → /reservar (teal; WhatsApp YA NO vive en el nav — los CTAs
// de mensajería son de la landing/contacto y se rigen por settings).
import { useTranslations, getLocalizedPath, getAlternateUrl, type Lang } from '../i18n/utils';
import { getTenant } from '../lib/tenant';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tenant = await getTenant();

const navItems = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.fleet', path: '/flota' },
  { key: 'nav.locations', path: '/ubicaciones' },
  { key: 'nav.faq', path: '/faq' },
  { key: 'nav.contact', path: '/contacto' },
];

const currentPath =
  Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

const logoColor = tenant.logo.type === 'icon' ? tenant.logo.color : '#0e7490';
const logoIcon: Record<string, string> = {
  bolt: 'M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2Z',
  car: 'M5 11l1.5-4.5A2 2 0 0 1 8.4 5h7.2a2 2 0 0 1 1.9 1.5L19 11m-14 0h14a2 2 0 0 1 2 2v4a1 1 0 0 1-1 1h-1a2 2 0 1 1-4 0H9a2 2 0 1 1-4 0H4a1 1 0 0 1-1-1v-4a2 2 0 0 1 2-2Z',
  key: 'M14 7a4 4 0 1 1-3.5 5.9L4 19.4V21H2v-2l6.1-6.5A4 4 0 0 1 14 7Zm2 1.5a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
  pin: 'M12 21s-7-5.3-7-11a7 7 0 1 1 14 0c0 5.7-7 11-7 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
};
const iconPath = logoIcon[tenant.logo.type === 'icon' ? tenant.logo.icon : 'bolt'];
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4">
    <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2 font-bold" aria-label={tenant.name}>
      {
        tenant.logo.type === 'image' && tenant.logo.url ? (
          <img src={tenant.logo.url} alt="" width="28" height="28" class="h-7 w-7 object-contain" />
        ) : (
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d={iconPath} style={`fill:${logoColor}`} />
          </svg>
        )
      }
      <span class="text-lg tracking-tight">{tenant.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      {
        navItems.map((item) => {
          const href = getLocalizedPath(item.path, lang);
          const active = currentPath === href || (href !== getLocalizedPath('/', lang) && currentPath.startsWith(href));
          return (
            <a
              href={href}
              class:list={[
                'rounded-md px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground',
                active ? 'text-brand' : 'text-muted-foreground',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {t(item.key)}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href={getAlternateUrl(currentPath)}
        class="hidden rounded-md border border-border px-2 py-1 text-xs font-semibold sm:block"
        aria-label={lang === 'es' ? 'Switch to English' : 'Cambiar a español'}
      >
        <span class:list={[lang === 'es' ? 'text-brand' : 'text-muted-foreground']} aria-current={lang === 'es' ? 'true' : undefined}>ES</span>
        <span class="text-muted-foreground">|</span>
        <span class:list={[lang === 'en' ? 'text-brand' : 'text-muted-foreground']} aria-current={lang === 'en' ? 'true' : undefined}>EN</span>
      </a>
      <a
        href={getLocalizedPath('/reservar', lang)}
        class="inline-flex items-center gap-2 rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-dark"
      >
        {t('nav.book')}
      </a>

      <details class="relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-md border border-border [&::-webkit-details-marker]:hidden"
          aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 flex w-56 flex-col gap-1 rounded-lg border border-border bg-background p-2 shadow-lg"
          aria-label={lang === 'es' ? 'Móvil' : 'Mobile'}
        >
          {
            navItems.map((item) => (
              <a
                href={getLocalizedPath(item.path, lang)}
                class="rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
              >
                {t(item.key)}
              </a>
            ))
          }
          <a
            href={getLocalizedPath('/reservar', lang)}
            class="mt-1 rounded-md bg-brand px-3 py-2 text-center text-sm font-semibold text-white"
          >
            {t('nav.book')}
          </a>
          <a href={getAlternateUrl(currentPath)} class="mt-1 rounded-md border border-border px-3 py-2 text-center text-xs font-semibold">
            {lang === 'es' ? 'Switch to English' : 'Cambiar a español'}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
