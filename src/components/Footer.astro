---
// Pie del sitio: NAP idéntico a /contacto y al JSON-LD (fuente única
// business.ts). CERO JavaScript: anchors tel:/mailto:/wa.me.
import { useTranslations, getLocalizedPath, type Lang } from '../i18n/utils';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import { author, business } from '../lib/business';
import { getTenant } from '../lib/tenant';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tenant = await getTenant();
const whatsappUrl = tenant.publicWhatsapp ? buildWhatsAppUrl(t('footer.whatsappMessage'), tenant.publicWhatsapp) : null;

const navItems = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.fleet', path: '/flota' },
  { key: 'nav.book', path: '/reservar' },
  { key: 'nav.locations', path: '/ubicaciones' },
  { key: 'nav.faq', path: '/faq' },
  { key: 'nav.contact', path: '/contacto' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-muted/40">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="flex items-center gap-2 text-lg font-bold">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2Z" class="fill-brand"></path>
        </svg>
        {tenant.name}
      </p>
      <p class="mt-3 text-sm text-muted-foreground">{t('footer.tagline')}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">{t('footer.contactTitle')}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {tenant.phones.map((phone) => (
          <li>
            <a class="hover:text-brand" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a>
          </li>
        ))}
        {tenant.email && (
          <li>
            <a class="hover:text-brand" href={`mailto:${tenant.email}`}>{tenant.email}</a>
          </li>
        )}
        {whatsappUrl && (
          <li>
            <a class="hover:text-brand" href={whatsappUrl} target="_blank" rel="noopener">WhatsApp</a>
          </li>
        )}
        {tenant.messengerUrl && (
          <li>
            <a class="hover:text-brand" href={tenant.messengerUrl} target="_blank" rel="noopener">Messenger</a>
          </li>
        )}
        <li class="text-muted-foreground">{t('footer.hours')}</li>
      </ul>
    </div>

    <nav aria-label={t('footer.navTitle')}>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">{t('footer.navTitle')}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a class="hover:text-brand" href={getLocalizedPath(item.path, lang)}>
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">{t('footer.addressTitle')}</h2>
      <address class="mt-3 space-y-2 text-sm not-italic">
        <p>{tenant.addressDisplay}</p>
        <a class="text-brand hover:underline" href={business.mapsUrl} target="_blank" rel="noopener">
          {lang === 'es' ? 'Cómo llegar' : 'Getting here'} →
        </a>
      </address>
    </div>
  </div>

  <div class="border-t border-border/60 py-4">
    <p class="mx-auto max-w-6xl px-4 text-center text-xs text-muted-foreground">
      © {year} {tenant.name}. {t('footer.rights')} · {t('footer.madeIn')}
      <span class="mx-1" aria-hidden="true">·</span>
      {lang === 'es' ? 'Hecho con' : 'Made with'} <span aria-hidden="true">💚</span> {lang === 'es' ? 'por' : 'by'}{' '}
      <a href={author.url} target="_blank" rel="noopener" class="font-medium hover:text-brand">
        {author.name}
      </a>
    </p>
  </div>
</footer>
