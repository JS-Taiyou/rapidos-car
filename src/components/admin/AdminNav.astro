---
// Nav interna del panel admin (lo usan las 4 páginas con sesión). Incluye
// el receptor de alertas en vivo: EventSource a /api/admin/notifications
// (sólo staff), beep-beep Web Audio + globito clicable por reservación
// entrante. El botón "Salir" sigue siendo el script inline de 5 líneas.
import { getTenant } from '../../lib/tenant';

const tenant = await getTenant();

const current = Astro.url.pathname;
const links = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/entregas', label: 'Entregas' },
  { href: '/admin/reservaciones', label: 'Reservaciones' },
  { href: '/admin/flota', label: 'Flota' },
  { href: '/admin/tarifas', label: 'Tarifas' },
  { href: '/admin/reportes', label: 'Reportes' },
  { href: '/admin/clientes', label: 'Clientes' },
  { href: '/admin/puntos', label: 'Puntos' },
  { href: '/admin/ajustes', label: 'Ajustes' },
  { href: '/admin/auditoria', label: 'Auditoría' },
];
---

<nav class="border-b bg-background">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-2 px-3 sm:gap-4 sm:px-4">
    <a href="/admin" class="flex shrink-0 items-center gap-2 font-bold">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2Z" class="fill-brand"></path>
      </svg>
      {tenant.name} <span class="hidden text-sm font-normal text-muted-foreground sm:inline">Panel</span>
    </a>
    <!-- En móvil la lista se desliza horizontal (sin scrollbar visual): el
         panel completo debe ser usable en la tablet del patio. -->
    <ul class="flex min-w-0 flex-1 items-center gap-0.5 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:gap-1">
      {
        links.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              class:list={[
                'block whitespace-nowrap rounded-md px-2.5 py-1.5 text-[13px] font-medium sm:px-3 sm:text-sm',
                current === link.href ? 'bg-accent text-accent-foreground' : 'text-muted-foreground hover:bg-accent',
              ]}
              aria-current={current === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <form id="logout-form" class="ml-auto shrink-0">
      <button
        type="submit"
        class="rounded-md border px-2.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent sm:px-3"
      >
        Salir
      </button>
    </form>
  </div>
</nav>

<!-- Host de globitos de alerta (esquina inferior derecha) -->
<div id="staff-alerts" class="fixed bottom-4 right-4 z-[60] flex w-80 flex-col gap-2"></div>

<style>
  @keyframes alert-in {
    from {
      transform: translateY(12px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  .alert-bubble {
    animation: alert-in 0.25s ease-out;
  }
  @keyframes badge-pulse {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.35);
    }
    100% {
      transform: scale(1);
    }
  }
  #quoted-count {
    display: inline-block;
  }
  #quoted-count.badge-pulse {
    animation: badge-pulse 0.35s ease;
  }
</style>

<script>
  document.getElementById('logout-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    await fetch('/api/auth', { method: 'DELETE' });
    window.location.href = '/admin/login';
  });

  // ---- Service worker del staff (Fase 5): agenda offline + cola de
  // capturas. Registro idempotente desde cualquier página del panel. ------
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch(() => undefined);
  }

  // ---- Alertas en vivo (sólo existen con sesión: el endpoint exige staff) --
  type Alert = {
    id: number;
    code: string;
    kind: 'rental' | 'lead';
    modelName: string;
    customerName: string | null;
    start: string;
    end: string;
    totalCents: number;
  };

  // Beep-beep: dos tonos ascendentes (A5→D6), ~0.3 s, ataque suave y decaimiento
  // exponencial — corto e inconfundible; el 2º armónico le da cuerpo para
  // atravesar ruido de fondo sin volverse estridente.
  let audioCtx: AudioContext | null = null;
  function ensureCtx(): AudioContext | null {
    try {
      if (!audioCtx) audioCtx = new AudioContext();
      if (audioCtx.state === 'suspended') void audioCtx.resume();
      return audioCtx;
    } catch {
      return null;
    }
  }
  // Autoplay: el navegador exige un gesto previo; el staff ya hizo login, pero
  // nos aseguramos desbloqueando con el primer pointerdown/keydown.
  const unlock = () => {
    ensureCtx();
    window.removeEventListener('pointerdown', unlock);
    window.removeEventListener('keydown', unlock);
  };
  window.addEventListener('pointerdown', unlock, { once: false });
  window.addEventListener('keydown', unlock, { once: false });

  function chime(): void {
    const ctx = ensureCtx();
    if (!ctx || ctx.state !== 'running') return;
    const t0 = ctx.currentTime + 0.01;
    for (const [freq, at] of [
      [880, t0],
      [1174.66, t0 + 0.15],
    ] as Array<[number, number]>) {
      const master = ctx.createGain();
      master.gain.setValueAtTime(0, at);
      master.gain.linearRampToValueAtTime(0.22, at + 0.012);
      master.gain.exponentialRampToValueAtTime(0.0001, at + 0.17);
      master.connect(ctx.destination);
      for (const [mult, vol] of [
        [1, 1],
        [2, 0.3],
      ] as Array<[number, number]>) {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.value = freq * mult;
        g.gain.value = vol;
        osc.connect(g);
        g.connect(master);
        osc.start(at);
        osc.stop(at + 0.2);
      }
    }
  }

  function showBubble(data: Alert): void {
    const host = document.getElementById('staff-alerts');
    if (!host) return;
    const isLead = data.kind === 'lead';
    const dates = (() => {
      const f = (iso: string) =>
        new Intl.DateTimeFormat('es-MX', { day: '2-digit', month: 'short', timeZone: 'America/Merida' }).format(new Date(iso));
      return `${f(data.start)} – ${f(data.end)}`;
    })();
    const money = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(data.totalCents / 100);

    const el = document.createElement('div');
    el.className = 'alert-bubble cursor-pointer rounded-xl border bg-background p-3 pr-8 shadow-lg transition-shadow hover:shadow-xl';
    el.style.borderLeft = `4px solid ${isLead ? '#d97706' : '#0e7490'}`;
    el.setAttribute('role', 'alert');
    el.innerHTML = `
      <p class="text-sm font-semibold">${isLead ? '⚠️' : '🚗'} ${isLead ? 'Lead sin disponibilidad' : 'Nueva reservación'}
        <span class="ml-1 font-mono text-xs font-normal text-muted-foreground">${data.code}</span></p>
      <p class="mt-0.5 text-sm">${data.modelName}</p>
      <p class="text-xs text-muted-foreground">${dates} · ${money}${data.customerName ? ` · ${data.customerName}` : ''}</p>
    `;
    const close = document.createElement('button');
    close.setAttribute('aria-label', 'Cerrar');
    close.className = 'absolute-none absolute right-2 top-2 text-muted-foreground hover:text-foreground';
    close.textContent = '✕';
    close.addEventListener('click', (e) => {
      e.stopPropagation();
      el.remove();
    });
    el.appendChild(close);
    // Clic = directo a la reserva (abre su diálogo en Reservaciones).
    el.addEventListener('click', () => {
      window.location.href = `/admin/reservaciones?code=${encodeURIComponent(data.code)}`;
    });
    host.appendChild(el);
    // Máximo 3 globitos apilados; los viejos se van primero.
    while (host.children.length > 3) host.firstElementChild?.remove();
    setTimeout(() => el.remove(), 15_000);
  }

  // ---- Badge "sin confirmar" en el link de Reservaciones -------------
  // Inicial por fetch; mutaciones por eventos (lead nuevo +1, alguien
  // confirmó/canceló un quoted -1); resync en cada (re)conexión del stream.
  const navLink = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav a')).find(
    (a) => a.getAttribute('href') === '/admin/reservaciones',
  );
  const badge = (() => {
    if (!navLink) return null;
    const el = document.createElement('span');
    el.id = 'quoted-count';
    el.className = 'ml-1.5 hidden rounded-full bg-amber-500 px-1.5 py-0.5 text-[11px] font-bold text-white';
    navLink.appendChild(el);
    return el;
  })();

  function setQuotedCount(n: number, pulse: boolean): void {
    if (!badge) return;
    if (n <= 0) {
      badge.classList.add('hidden');
      badge.textContent = '';
      return;
    }
    badge.classList.remove('hidden');
    badge.textContent = String(n);
    if (pulse) {
      badge.classList.remove('badge-pulse');
      void badge.offsetWidth; // reflow: reinicia la animación
      badge.classList.add('badge-pulse');
    }
  }

  function bumpQuoted(delta: number): void {
    setQuotedCount(Number(badge?.textContent || '0') + delta, true);
  }

  async function refreshQuotedCount(): Promise<void> {
    if (!badge) return;
    try {
      const res = await fetch('/api/admin/bookings?status=quoted&kind=rental');
      if (!res.ok) return;
      const data = (await res.json()) as { bookings?: unknown[] };
      setQuotedCount(data.bookings?.length ?? 0, false);
    } catch {
      // sin conexión: el badge conserva su último valor
    }
  }
  void refreshQuotedCount();

  const es = new EventSource('/api/admin/notifications');
  es.addEventListener('ready', () => {
    // (Re)conexión del stream: resincroniza el contador con la BD.
    void refreshQuotedCount();
  });
  es.addEventListener('new-booking', (ev) => {
    try {
      const data = JSON.parse((ev as MessageEvent).data) as Alert;
      showBubble(data);
      chime();
      if (data.kind === 'lead') bumpQuoted(1);
    } catch {
      // payload inválido: se ignora
    }
  });
  es.addEventListener('booking-status', (ev) => {
    try {
      const change = JSON.parse((ev as MessageEvent).data) as { from: string; to: string };
      if (change.from === 'quoted') bumpQuoted(-1);
    } catch {
      // payload inválido: se ignora
    }
  });
</script>
