---
// Contacto ES (/contacto) — SIN formulario (decisión fuerte, spec §3.6):
// wa.me filtra mejor que cualquier honeypot; TODO request entra al mismo
// embudo. NAP idéntico al Footer y al JSON-LD (fuente única business.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../i18n/utils';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import { getTenant } from '../lib/tenant';
import { business } from '../lib/business';


export const prerender = false;
const t = useTranslations('es');
const tenant = await getTenant();
const whatsappUrl = tenant.publicWhatsapp ? buildWhatsAppUrl(t('contact.whatsappMessage'), tenant.publicWhatsapp) : null;
---

<BaseLayout lang="es" title={`${t('contact.title')} — Rapidoz Rental`} description={t('contact.intro')} alternateUrl="/en/contact">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight">{t('contact.title')}</h1>
    <p class="mt-2 text-muted-foreground">{t('contact.intro')}</p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="space-y-4">
        {whatsappUrl && (
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-4 rounded-xl border border-[#25D366] bg-[#25D366]/5 p-5 transition-colors hover:bg-[#25D366]/10"
        >
          <svg width="32" height="32" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
            <path
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1a10 10 0 0 1-4-2.6 9.3 9.3 0 0 1-1.9-3c-.2-.6-.1-1.2.1-1.6.2-.4.6-.9 1-1.1.2-.1.5-.1.7 0 .2.1.4.2.5.5l.7 1.5c.1.2.1.4 0 .6l-.4.6c-.1.2-.2.3-.1.5.4.8 1.6 2.2 3 2.8.2.1.4 0 .5-.1l.6-.6c.2-.2.4-.2.6-.1l1.5.8c.2.1.4.3.4.5.1.2 0 .5-.1.7Z"
            ></path>
          </svg>
          <span>
            <span class="block text-lg font-semibold">{t('contact.whatsappCta')}</span>
            <span class="block text-sm text-muted-foreground">{business.phoneDisplay}</span>
          </span>
        </a>
        )}

        <div class="rounded-xl border p-5 text-sm">
          <dl class="space-y-3">
            <div class="flex justify-between gap-4">
              <dt class="text-muted-foreground">{t('contact.phone')}</dt>
              <dd><a class="font-medium hover:text-brand" href={`tel:${tenant.phones[0] ?? ''}`}>{tenant.phones[0] ?? ''}</a></dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted-foreground">{t('contact.email')}</dt>
              <dd><a class="font-medium hover:text-brand" href={`mailto:${tenant.email ?? ''}`}>{tenant.email}</a></dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-muted-foreground">{t('contact.hours')}</dt>
              <dd class="text-right">
                Lun a Sáb, 8:00 – 20:00<br />
                Dom, 9:00 – 15:00
                <span class="block text-xs text-muted-foreground">{t('contact.hoursNote')}</span>
              </dd>
            </div>
          </dl>
        </div>

        <a href={getLocalizedPath('/reservar', 'es')} class="inline-block text-sm font-medium text-brand hover:underline">
          {t('contact.quoteCta')} →
        </a>
      </div>

      <div class="space-y-3">
        <address class="rounded-xl border p-5 text-sm not-italic">
          <p class="font-semibold">{t('contact.addressLabel')}</p>
          <p class="mt-1 text-muted-foreground">{tenant.addressDisplay}</p>
          <a
            class="mt-2 inline-block text-sm font-medium text-brand hover:underline"
            href={business.mapsUrl}
            target="_blank"
            rel="noopener"
          >
            {t('contact.mapCta')} →
          </a>
        </address>
        <div class="overflow-hidden rounded-xl border">
          <iframe
            title={t('contact.mapTitle')}
            src="https://www.google.com/maps?q=Calle%2060%20Nte%20339%20Centro%20M%C3%A9rida&output=embed"
            width="100%"
            height="320"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
