---
// Admin — Reservaciones (/admin/reservaciones) — shell que monta la isla
// ReservationsBoard. El frontmatter SOLO hace la guardia; los datos los
// fetchea la isla contra /api/admin/bookings (una sola fuente de verdad).
import { requireAdmin } from '../../lib/auth';
import AdminNav from '../../components/admin/AdminNav.astro';
import '../../styles/global.css';
import ReservationsBoard from '../../components/react/admin/ReservationsBoard.tsx';

export const prerender = false;

const admin = await requireAdmin(Astro, ['admin', 'desk']);
if (admin instanceof Response) return admin;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reservaciones — Rapidoz Admin</title>
  </head>
  <body class="min-h-screen bg-muted/30">
    <AdminNav role={admin.role} />
    <main class="mx-auto max-w-6xl space-y-6 px-4 py-8">
      <h1 class="text-2xl font-bold tracking-tight">Reservaciones</h1>
      <!-- client:load: esta página ES la herramienta; hidrata de inmediato. -->
      <ReservationsBoard client:load />
    </main>
  </body>
</html>
