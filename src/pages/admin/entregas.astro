---
// Admin — Entregas (/admin/entregas) — la pantalla del patio (ROADMAP Fase
// 3). Shell que monta HandoverBoard; los datos viven en /api/admin/agenda
// (una sola fuente de verdad, y la que cacheará el PWA del staff).
import { requireAdmin } from '../../lib/auth';
import AdminNav from '../../components/admin/AdminNav.astro';
import '../../styles/global.css';
import HandoverBoard from '../../components/react/admin/HandoverBoard.tsx';

export const prerender = false;

const admin = await requireAdmin(Astro, ['admin', 'desk', 'yard']);
if (admin instanceof Response) return admin;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Entregas — Rapidoz Admin</title>
    <!-- PWA del staff (Fase 5): instalable con icono/nombre del tenant; la
         agenda funciona offline y las capturas sin red se suben solas. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0e7490" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Entregas" />
    <link rel="apple-touch-icon" href="/admin/app-icon/192.png" />
  </head>
  <body class="min-h-screen bg-muted/30">
    <AdminNav role={admin.role} />
    <main class="mx-auto max-w-6xl space-y-6 px-4 py-6">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">Entregas del día</h1>
        <p class="text-sm text-muted-foreground">Checklist, kilometraje, combustible y fotos de evidencia.</p>
      </div>
      <!-- client:load: ES la herramienta del patio; hidrata de inmediato. -->
      <HandoverBoard client:load />
    </main>
    <script>
      // Registrar el service worker (idempotente) + botón de instalación.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => undefined);
      }
      // A2HS: el prompt nativo se gatilla desde el botón (requiere gesto).
      let installPrompt: Event & { prompt?: () => Promise<void> } | null = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        installPrompt = e as typeof installPrompt;
        document.getElementById('pwa-install')?.classList.remove('hidden');
      });
      document.getElementById('pwa-install')?.addEventListener('click', async () => {
        await installPrompt?.prompt?.();
        document.getElementById('pwa-install')?.classList.add('hidden');
      });
    </script>
    <!-- Botón discreto de instalación (aparece cuando el navegador lo permite). -->
    <button
      id="pwa-install"
      class="fixed bottom-4 left-4 z-40 hidden rounded-full bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-lg"
    >
      📲 Instalar app
    </button>
  </body>
</html>
