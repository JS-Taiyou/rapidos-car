---
// Admin — Ajustes (/admin/ajustes) — perfil del tenant en runtime:
// identidad, mensajería (WhatsApp público/staff, Messenger) y logo. La
// isla guarda vía PATCH /api/admin/settings y el sitio refleja al instante
// (cache de tenant invalidado).
import { requireAdmin } from '../../lib/auth';
import { getTenant } from '../../lib/tenant';
import AdminNav from '../../components/admin/AdminNav.astro';
import SettingsEditor from '../../components/react/admin/SettingsEditor.tsx';
import '../../styles/global.css';

export const prerender = false;

const admin = await requireAdmin(Astro);
if (admin instanceof Response) return admin;

const tenant = await getTenant();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ajustes — {tenant.name} Admin</title>
  </head>
  <body class="min-h-screen bg-muted/30">
    <AdminNav />
    <main class="mx-auto max-w-4xl space-y-6 px-4 py-8">
      <h1 class="text-2xl font-bold tracking-tight">Ajustes</h1>
      <SettingsEditor
        client:load
        tenant={{
          name: tenant.name,
          email: tenant.email ?? '',
          address: tenant.addressDisplay ?? '',
          phones: tenant.phones,
          publicWhatsapp: tenant.publicWhatsapp ?? '',
          staffWhatsapp: tenant.staffWhatsapp,
          messengerUrl: tenant.messengerUrl ?? '',
          logo: tenant.logo,
        }}
      />
    </main>
  </body>
</html>
