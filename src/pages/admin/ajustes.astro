---
// Admin — Ajustes (/admin/ajustes) — SSR: guardia + lectura inicial del
// settings; la isla SettingsEditor guarda vía PATCH. Primer campo del
// spec §4.5: WhatsApp del staff (runtime, sin rebuild).
import { requireAdmin } from '../../lib/auth';
import { sql } from '../../lib/db';
import AdminNav from '../../components/admin/AdminNav.astro';
import SettingsEditor from '../../components/react/admin/SettingsEditor.tsx';
import '../../styles/global.css';

export const prerender = false;

const admin = await requireAdmin(Astro);
if (admin instanceof Response) return admin;

const rows = await sql`SELECT value FROM settings WHERE key = 'whatsapp_staff_number'`;
const initialNumber = String(rows[0]?.value ?? '');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ajustes — Rapidoz Admin</title>
  </head>
  <body class="min-h-screen bg-muted/30">
    <AdminNav />
    <main class="mx-auto max-w-6xl space-y-6 px-4 py-8">
      <h1 class="text-2xl font-bold tracking-tight">Ajustes</h1>
      <SettingsEditor client:load initialNumber={initialNumber} />
      <p class="max-w-md text-xs text-muted-foreground">
        El WhatsApp público del sitio (CTAs de contacto) es parte del perfil del tenant en
        <code class="mx-1">src/lib/business.ts</code> y cambia al recompilar.
      </p>
    </main>
  </body>
</html>
