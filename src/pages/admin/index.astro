---
// Admin — Dashboard (/admin) — SSR, SIN isla: listas de solo-lectura, HTML
// plano, cero JS (las mutaciones viven en /admin/reservaciones). "Hoy" se
// calcula EN SQL con America/Merida (§2.13), nunca con new Date() servidor.
import { requireAdmin } from '../../lib/auth';
import { sql } from '../../lib/db';
import AdminNav from '../../components/admin/AdminNav.astro';
import '../../styles/global.css';

export const prerender = false;

// GUARDIA PRIMERO (§2.3): sin sesión, nada de lo siguiente se ejecuta.
const admin = await requireAdmin(Astro, ['admin', 'desk', 'yard']);
if (admin instanceof Response) return admin;

// Entregas de hoy por TRAMO (los bloqueos kind='block' no son entregas): un
// tramo que empieza hoy = una unidad que se entrega hoy, aunque la renta ya
// lleve días corriendo con otro auto (migración 006).
const pickups = await sql`
  SELECT b.code, b.customer_name, b.customer_phone, b.flight_number,
         s.pickup_zone, lower(s.period) AS start_at,
         v.plate, vm.name AS model_name
  FROM booking_segments s
  JOIN bookings b ON b.id = s.booking_id AND b.kind = 'rental'
                  AND b.status IN ('confirmed','active')
  JOIN vehicle_models vm ON vm.id = s.model_id
  LEFT JOIN vehicles v ON v.id = s.vehicle_id
  WHERE s.status IN ('reserved','active')
    AND (lower(s.period) AT TIME ZONE 'America/Merida')::date
        = (now() AT TIME ZONE 'America/Merida')::date
  ORDER BY lower(s.period)
`;

// Devoluciones de hoy: upper(period) del tramo es el momento exacto de
// devolución (el rango es [inicio, fin)).
const returns = await sql`
  SELECT b.code, b.customer_name, b.customer_phone,
         upper(s.period) AS end_at,
         v.plate, vm.name AS model_name
  FROM booking_segments s
  JOIN bookings b ON b.id = s.booking_id AND b.kind = 'rental'
                  AND b.status IN ('confirmed','active')
  JOIN vehicle_models vm ON vm.id = s.model_id
  LEFT JOIN vehicles v ON v.id = s.vehicle_id
  WHERE s.status IN ('reserved','active')
    AND (upper(s.period) AT TIME ZONE 'America/Merida')::date
        = (now() AT TIME ZONE 'America/Merida')::date
  ORDER BY upper(s.period)
`;

// Unidades que alcanzaron su intervalo de servicio (mantenimiento).
const serviceRows = await sql`
  SELECT v.plate, m.name AS model_name
  FROM vehicles v
  JOIN vehicle_models m ON m.id = v.model_id
  WHERE v.needs_service = true
  ORDER BY v.plate
`;

// Ocupación ahora: numerador = unidades amarradas por tramos vigentes;
// denominador = unidades activas (taller/retiradas no son flota disponible).
const occupancyRows = await sql`
  SELECT
    (SELECT COUNT(DISTINCT s.vehicle_id) FROM booking_segments s
      JOIN bookings b ON b.id = s.booking_id
      WHERE b.kind = 'rental' AND b.status IN ('confirmed','active')
        AND s.status IN ('reserved','active') AND s.period @> now()) AS busy,
    (SELECT COUNT(*) FROM vehicles WHERE status = 'active') AS fleet
`;
const busy = Number(occupancyRows[0]?.busy ?? 0);
const fleet = Number(occupancyRows[0]?.fleet ?? 0);
const occupancyPct = fleet > 0 ? Math.round((busy / fleet) * 100) : 0;

const timeFmt = new Intl.DateTimeFormat('es-MX', {
  timeStyle: 'short',
  timeZone: 'America/Merida',
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Panel — Rapidoz</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0e7490" />
  </head>
  <body class="min-h-screen bg-muted/30">
    <AdminNav role={admin.role} />
    <main class="mx-auto max-w-6xl space-y-8 px-4 py-8">
      <p class="text-sm text-muted-foreground">Hola, <strong>{admin.email}</strong></p>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border bg-background p-5">
          <p class="text-sm text-muted-foreground">Entregas hoy</p>
          <p class="mt-1 text-4xl font-bold">{pickups.length}</p>
        </div>
        <div class="rounded-xl border bg-background p-5">
          <p class="text-sm text-muted-foreground">Devoluciones hoy</p>
          <p class="mt-1 text-4xl font-bold">{returns.length}</p>
        </div>
        <div class="rounded-xl border bg-background p-5">
          <p class="text-sm text-muted-foreground">Ocupación</p>
          <p class="mt-1 text-4xl font-bold">{busy}/{fleet}</p>
        </div>
      </div>

      {
        serviceRows.length > 0 && (
          <div class="rounded-xl border border-amber-300 bg-amber-50 p-5" data-tour="dash-service">
            <p class="text-sm font-semibold text-amber-900">
              🔧 Servicio pendiente ({serviceRows.length})
            </p>
            <p class="mt-1 text-sm text-amber-800">
              {serviceRows.map((r) => `${r.plate} (${r.model_name})`).join(' · ')}
            </p>
            <p class="mt-1 text-xs text-amber-700">
              Alcanzaron el intervalo de kilometraje: mándalas a taller y registra el servicio en Flota.
            </p>
          </div>
        )
      }

      <div class="rounded-xl border bg-background p-5">
        <div class="mb-2 flex items-center justify-between text-sm">
          <span class="font-medium">Flota en renta ahora</span>
          <span class="text-muted-foreground">{occupancyPct}%</span>
        </div>
        <div class="h-3 w-full overflow-hidden rounded-full bg-muted">
          <div class="h-full rounded-full bg-brand" style={`width: ${occupancyPct}%`}></div>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <section class="rounded-xl border bg-background" data-tour="dash-pickups">
          <h2 class="border-b px-5 py-3 font-semibold">Entregas de hoy</h2>
          {
            pickups.length === 0 ? (
              <p class="px-5 py-8 text-center text-sm text-muted-foreground">Sin entregas hoy.</p>
            ) : (
              <ul class="divide-y text-sm">
                {pickups.map((b) => (
                  <li class="flex items-start justify-between gap-3 px-5 py-3">
                    <div>
                      <p class="font-medium">
                        {b.customer_name}
                        <span class="ml-2 font-mono text-xs text-muted-foreground">{b.code}</span>
                      </p>
                      <p class="text-xs text-muted-foreground">
                        {b.model_name} · {b.plate} · {b.pickup_zone}
                        {b.flight_number ? ` · ✈ ${b.flight_number}` : ''}
                      </p>
                    </div>
                    <span class="shrink-0 font-mono text-xs">{timeFmt.format(new Date(b.start_at))}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        <section class="rounded-xl border bg-background" data-tour="dash-returns">
          <h2 class="border-b px-5 py-3 font-semibold">Devoluciones de hoy</h2>
          {
            returns.length === 0 ? (
              <p class="px-5 py-8 text-center text-sm text-muted-foreground">Sin devoluciones hoy.</p>
            ) : (
              <ul class="divide-y text-sm">
                {returns.map((b) => (
                  <li class="flex items-start justify-between gap-3 px-5 py-3">
                    <div>
                      <p class="font-medium">
                        {b.customer_name}
                        <span class="ml-2 font-mono text-xs text-muted-foreground">{b.code}</span>
                      </p>
                      <p class="text-xs text-muted-foreground">
                        {b.model_name} · {b.plate}
                      </p>
                    </div>
                    <span class="shrink-0 font-mono text-xs">{timeFmt.format(new Date(b.end_at))}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </section>
      </div>
    </main>
  </body>
</html>
