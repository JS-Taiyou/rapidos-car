---
// Admin — Login (/admin/login) — SSR. ÚNICA página /admin/* SIN requireAdmin
// (llamarla aquí sería un bucle de redirects). El "card" es HTML+Tailwind
// puro: el Card de shadcn es React.
import { getSessionUser, SESSION_COOKIE } from '../../lib/auth';
import { sql } from '../../lib/db';
import '../../styles/global.css';
import LoginForm from '../../components/react/admin/LoginForm.tsx';
import { getTenant } from '../../lib/tenant';

export const prerender = false;

// Sesión ya válida → al panel, sin volver a ver el formulario (un re-login
// innecesario siembra sesiones duplicadas).
const token = Astro.cookies.get(SESSION_COOKIE)?.value;
const tenant = await getTenant();
if (token) {
  const user = await getSessionUser(sql, token);
  if (user) return Astro.redirect('/admin');
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso — Rapidoz Admin</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-muted">
    <main class="w-full max-w-sm rounded-xl border bg-background p-8 shadow">
      <h1 class="flex items-center gap-2 text-xl font-bold">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M13 2 4.5 13.5H11L9.5 22 19 10h-6.5L13 2Z" class="fill-brand"></path>
        </svg>
        {tenant.name}
      </h1>
      <p class="mb-6 mt-1 text-sm text-muted-foreground">Panel interno</p>
      <LoginForm client:load />
    </main>
  </body>
</html>
