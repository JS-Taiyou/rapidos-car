---
// Reservar ES (/reservar) — cascarón estático + isla BookingFlow
// (client:load: la isla ES la página). <noscript> con WhatsApp: el funnel
// NO puede morir si falla el JS (spec §3.6). La página NO procesa query
// params: la isla los lee sola (una sola fuente de verdad).
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingFlow from '../components/react/booking/BookingFlow';
import { useTranslations } from '../i18n/utils';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import { getPickupPoints } from '../lib/pickup-points';


export const prerender = false;
const t = useTranslations('es');
const whatsappFallback = buildWhatsAppUrl(t('booking.noscriptMessage'));
---

<BaseLayout lang="es" title={t('booking.pageTitle')} description={t('booking.pageDesc')} alternateUrl="/en/book">
  <section class="mx-auto max-w-4xl px-4 py-10">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">{t('booking.pageTitle')}</h1>
        <p class="mt-2 text-sm text-muted-foreground">{t('booking.stepsSummary')}</p>
      </div>
      <!-- Onboarding opt-in (driver.js se carga sólo al hacer clic). -->
      <button
        id="how-it-works"
        type="button"
        class="rounded-full border px-4 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
      >
        ¿Cómo funciona?
      </button>
    </div>

    <!-- min-height: sin él, el contenido salta al hidratar la isla (CLS). -->
    <div class="mt-8 min-h-[32rem]" data-tour="book-wizard">
      <div data-tour="book-widget">
        <BookingFlow client:load lang="es" zones={(await getPickupPoints()).map((p) => ({ zone: p.key, name: p.name, feeCents: p.feeCents ?? 0 }))} />
      </div>
    </div>

    <noscript>
      <div class="mt-6 rounded-xl border border-amber-300 bg-amber-50 p-5 text-center">
        <p class="font-medium text-amber-900">{t('booking.noscriptTitle')}</p>
        <a
          href={whatsappFallback}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-5 py-2.5 font-semibold text-white"
        >
          {t('booking.noscriptCta')}
        </a>
      </div>
    </noscript>

    <ul class="mt-8 grid gap-2 text-sm text-muted-foreground sm:grid-cols-3">
      <li>✓ {t('booking.trust.insurance')}</li>
      <li>✓ {t('booking.trust.cancelation')}</li>
      <li>✓ {t('booking.trust.support')}</li>
    </ul>
  </section>
  <script>
    document.getElementById('how-it-works')?.addEventListener('click', async () => {
      const { startBookingTour } = await import('../lib/tours');
      await startBookingTour('es');
    });
  </script>
</BaseLayout>
