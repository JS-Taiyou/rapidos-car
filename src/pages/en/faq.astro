---
// FAQ EN (/en/faq) — ESPEJO de src/pages/faq.astro. Preguntas redactadas a
// mano en inglés (spec §1: sin machine translation); el JSON-LD también va
// en inglés (mismo array, mismas claves, valores EN).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

const questions = [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => ({
  q: t(`faq.q${n}`),
  a: t(`faq.a${n}`),
}));

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout lang="en" title={`${t('faq.title')} — Rapidoz Rental`} description={t('faq.subtitle')} alternateUrl="/faq">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight">{t('faq.title')}</h1>
    <p class="mt-2 text-muted-foreground">{t('faq.subtitle')}</p>

    <div class="mt-8 divide-y rounded-xl border">
      {
        questions.map((item, i) => (
          <details class="group p-4" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 font-medium [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />
</BaseLayout>
