---
// Fleet EN (/en/fleet) — ESPEJO de src/pages/flota/index.astro (incluido el
// filtro ?cat= por pills, cero JS). La QUERY es IDÉNTICA: los datos de
// catálogo NO se traducen; solo cambian los textos de UI.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CarCard from '../../../components/CarCard.astro';
import { getFleetCatalog } from '../../../lib/fleet-cache';
import { useTranslations, getLocalizedPath } from '../../../i18n/utils';
import { buildWhatsAppUrl } from '../../../lib/whatsapp';

export const prerender = false;

const t = useTranslations('en');

const cat = Astro.url.searchParams.get('cat');
const validCats = ['small', 'compact', 'medium', 'large', 'van', 'cargo'];
const activeCat = cat && validCats.includes(cat) ? cat : null;

// Snapshot en memoria (src/lib/fleet-cache.ts): la primera visita paga la
// query; el resto lee memoria. El filtro ?cat= se aplica en JS sobre el
// catálogo completo (28 renglones).
const allModels = await getFleetCatalog();
const models = activeCat ? allModels.filter((m) => m.category === activeCat) : allModels;

const emptyWhatsapp = buildWhatsAppUrl(t('fleet.emptyCta'));
const basePath = getLocalizedPath('/flota', 'en');
const filterHrefs = (value: string) => (value ? `${basePath}?cat=${value}` : basePath);
---

<BaseLayout lang="en" title={`${t('fleet.title')} — Rapidoz Car Rental`} description={t('fleet.description')} alternateUrl="/flota">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight">{t('fleet.title')}</h1>
    <p class="mt-2 text-muted-foreground">{t('fleet.subtitle')}</p>

    <nav aria-label="Filter by size" class="mt-6 flex flex-wrap gap-2">
      <a
        href={filterHrefs('')}
        class:list={[
          'rounded-full border px-4 py-1.5 text-sm font-medium transition-colors',
          activeCat === null
            ? 'border-brand bg-brand text-white'
            : 'bg-background text-muted-foreground hover:border-brand/40 hover:text-brand',
        ]}
        aria-current={activeCat === null ? 'true' : undefined}
      >
        {t('fleet.all')}
      </a>
      {
        validCats.map((c) => (
          <a
            href={filterHrefs(c)}
            class:list={[
              'rounded-full border px-4 py-1.5 text-sm font-medium transition-colors',
              activeCat === c
                ? 'border-brand bg-brand text-white'
                : 'bg-background text-muted-foreground hover:border-brand/40 hover:text-brand',
            ]}
            aria-current={activeCat === c ? 'true' : undefined}
          >
            {t(`fleet.category.${c}`)}
          </a>
        ))
      }
    </nav>

    {
      models.length === 0 ? (
        <div class="mt-10 rounded-xl border bg-muted/30 p-10 text-center">
          <p class="text-muted-foreground">{t('fleet.empty')}</p>
          <a
            href={emptyWhatsapp}
            target="_blank"
            rel="noopener"
            class="mt-4 inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-5 py-2.5 font-semibold text-white"
          >
            WhatsApp
          </a>
        </div>
      ) : (
        <>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {models.map((model) => (
              <CarCard model={model} lang="en" />
            ))}
          </div>
          <p class="mt-8 text-xs text-muted-foreground">{t('fleet.pricesNote')}</p>
        </>
      )
    }
  </section>
</BaseLayout>
