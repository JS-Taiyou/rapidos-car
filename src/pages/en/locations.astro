---
// Locations EN (/en/locations) — ESPEJO de src/pages/ubicaciones.astro.
// Los NOMBRES de zona no se traducen (son datos compartidos con la BD);
// las descripciones sí, vía locations.zones.*.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, getLocalizedPath } from '../../i18n/utils';

const t = useTranslations('en');

const feeFmt = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 });
const zones = [
  { key: 'airport_mid', feeCents: 0 },
  { key: 'centro', feeCents: 15000 },
  { key: 'norte', feeCents: 20000 },
  { key: 'hotel_zone', feeCents: 25000 },
];
---

<BaseLayout lang="en" title={`${t('locations.title')} — Rapidoz Car Rental`} description={t('locations.subtitle')} alternateUrl="/ubicaciones">
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight">{t('locations.title')}</h1>
    <p class="mt-2 text-muted-foreground">{t('locations.subtitle')}</p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <div>
        <h2 class="text-lg font-semibold">{t('locations.airport.title')}</h2>
        <p class="mt-3 text-sm text-muted-foreground">{t('locations.airport.meetingPoint')}</p>
        <ol class="mt-4 space-y-2 text-sm">
          <li class="flex gap-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand text-xs font-bold text-white">1</span>
            {t('locations.airport.step1')}
          </li>
          <li class="flex gap-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand text-xs font-bold text-white">2</span>
            {t('locations.airport.step2')}
          </li>
          <li class="flex gap-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand text-xs font-bold text-white">3</span>
            {t('locations.airport.step3')}
          </li>
        </ol>
        <p class="mt-4 rounded-lg bg-brand-soft p-3 text-sm text-brand-dark">
          ✈️ {t('locations.airport.flightNote')}
        </p>
      </div>

      <div>
        <h2 class="text-lg font-semibold">{t('locations.hotel.title')}</h2>
        <p class="mt-3 text-sm text-muted-foreground">{t('locations.hotel.note')}</p>
        <ul class="mt-4 divide-y rounded-xl border text-sm">
          {
            zones.map((zone) => (
              <li class="flex items-center justify-between gap-3 p-3">
                <div>
                  <p class="font-medium">{t(`locations.zones.${zone.key}.name`)}</p>
                  <p class="text-xs text-muted-foreground">{t(`locations.zones.${zone.key}.desc`)}</p>
                </div>
                <span class="shrink-0 font-semibold">
                  {zone.feeCents === 0 ? 'Free' : `+${feeFmt.format(zone.feeCents / 100)}`}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 overflow-hidden rounded-xl border">
      <iframe
        title={t('locations.mapTitle')}
        src="https://www.google.com/maps?q=Aeropuerto%20Internacional%20de%20M%C3%A9rida&output=embed"
        width="100%"
        height="360"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="mt-8 text-center">
      <a
        href={getLocalizedPath('/reservar', 'en')}
        class="inline-flex items-center justify-center rounded-lg bg-brand px-6 py-3 font-semibold text-white transition-colors hover:bg-brand-dark"
      >
        {t('locations.cta')}
      </a>
    </div>
  </section>
</BaseLayout>
